# ── Public (exposed to the browser) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=پوما ایر

# ── Server-only ───────────────────────────────────────────────────
# Base URL of the separate abzar/api service the storefront proxies to.
API_BASE_URL=http://localhost:4000
# Shared secret used to sign/verify the storefront <-> api service calls (optional).
API_SERVICE_TOKEN=
# Name of the HttpOnly cookie that stores the API-issued session token.
SESSION_COOKIE_NAME=abzar_session
# Node env is provided by the runtime; do not set manually in prod.

# ── Dev-only auth bypass ──────────────────────────────────────────
# While abzar/api auth is not wired up locally, the dashboard gate is
# short-circuited with a mock super-admin session. This ONLY works when
# NODE_ENV !== 'production'. Set to 0 to restore the real session gate in dev.
DEV_AUTH_BYPASS=1
