# Copy to ../.env.production (repo root) on the server (never commit). docker compose reads it
# both as env_file (runtime) and for the build args in docker-compose.prod.yml.

# ── Public (inlined into the browser bundle at build time) ────────────
NEXT_PUBLIC_SITE_URL=https://www.technorextools.com
NEXT_PUBLIC_SITE_NAME=تکنورکس

# ── Server-only ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Versioned API base. Health probe is un-versioned: https://api.technorextools.com/health
API_BASE_URL=https://api.technorextools.com/api/v1
# Must match abzar/api .env.production exactly; sent as the X-Service-Token header.
API_SERVICE_TOKEN=
SESSION_COOKIE_NAME=abzar_session
# HMAC key for expiring document download links (>= 16 chars, required in prod).
DOCUMENT_SIGNING_SECRET=
